PORT=8080
CONFIG_SERVICE_URL=
# Default for container-to-container communication on the same Docker network.
# If you run the API on your host machine instead, replace this with localhost:9092 or localhost:29092 depending on your Kafka stack.
KAFKA_BROKERS=kafka:9092
KAFKA_SECURITY_PROTOCOL=
KAFKA_SASL_MECHANISM=
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_TOPIC_ENERGY_CONSUMPTION_RECORDED=energy.consumption.recorded
KAFKA_TOPIC_ENERGY_READING_CREATED=energy.reading.created
KAFKA_TOPIC_DEVICE_REGISTERED=device.registered
KAFKA_TOPIC_DEVICE_STATUS_UPDATED=device.status.updated
KAFKA_TOPIC_ANALYTICS_BILL_PREDICTION_GENERATED=analytics.bill_prediction.generated
KAFKA_TOPIC_ANALYTICS_RECOMMENDATION_GENERATED=analytics.recommendation.generated
KAFKA_TOPIC_ANALYTICS_ANOMALY_DETECTED=analytics.anomaly.detected
KAFKA_TOPIC_ANALYTICS_DEVICE_IDENTIFIED=analytics.device_identified
KAFKA_TOPIC_ANALYTICS_CONSUMPTION_RANKING_GENERATED=analytics.consumption_ranking.generated
DATABASE_URL=
MONGODB_URI=
ENVIRONMENT=production

# Existing optional settings used by the service
CONFIG_SERVICE_TIMEOUT_SECONDS=3.0
SERVICE_NAME=analytics-service
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
MONGODB_DATABASE=sems_analytics_db
