PORT=8080
ALLOWED_ORIGINS=https://your-frontend.example.com,https://your-admin.example.com
CONFIG_SERVICE_URL=https://your-config-service.example.com
KAFKA_BROKERS=your-kafka-broker-1:9092,your-kafka-broker-2:9092
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_USERNAME=your-kafka-username
KAFKA_PASSWORD=your-kafka-password
KAFKA_TOPIC_ENERGY_EVENTS=energy.events
KAFKA_TOPIC_ANALYTICS_EVENTS=analytics.events
KAFKA_CONSUMED_TOPICS=["energy.events"]
KAFKA_CONSUMED_EVENT_TYPES=["energy.consumption.recorded"]
KAFKA_EVENT_TYPE_ENERGY_CONSUMPTION_RECORDED=energy.consumption.recorded
KAFKA_EVENT_TYPE_ANALYTICS_BILL_PREDICTION_GENERATED=analytics.bill_prediction.generated
KAFKA_EVENT_TYPE_ANALYTICS_RECOMMENDATION_GENERATED=analytics.recommendation.generated
KAFKA_EVENT_TYPE_ANALYTICS_ANOMALY_DETECTED=analytics.anomaly.detected
KAFKA_EVENT_TYPE_ANALYTICS_DEVICE_IDENTIFIED=analytics.device_identified
KAFKA_EVENT_TYPE_ANALYTICS_CONSUMPTION_RANKING_GENERATED=analytics.consumption_ranking.generated
AZURE_EVENT_HUBS_FQDN=<your-namespace>.servicebus.windows.net
AZURE_EVENT_HUBS_USERNAME=$ConnectionString
AZURE_EVENT_HUBS_CONNECTION_STRING=Endpoint=sb://<your-namespace>.servicebus.windows.net/;SharedAccessKeyName=<policy>;SharedAccessKey=<key>
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DATABASE=sems_analytics_db
ENVIRONMENT=production
CONFIG_SERVICE_TIMEOUT_SECONDS=3.0
SERVICE_NAME=analytics-service
